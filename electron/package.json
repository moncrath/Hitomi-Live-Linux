{
  "name": "hitomi-live-electron",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Shell Electron Hitomi Live untuk Linux (WebKitGTK sistem tak bisa diandalkan)",
  "main": "main.mjs",
  "scripts": {
    "build:app": "npm --prefix ../app run build",
    "start": "electron . --ozone-platform=x11",
    "dev": "HITOMI_DEV_URL=http://127.0.0.1:5173 electron . --ozone-platform=x11"
  },
  "devDependencies": {
    "electron": "44.7.0"
  }
}
